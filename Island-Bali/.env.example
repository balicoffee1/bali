# Шаблон окружения. Реальный .env в git не хранится (см. .gitignore) —
# значения на проде и в docker-compose разные, и раньше выкатка затирала
# боевую конфигурацию репозиторной.

# --- Django ---
SECRET_KEY=<сгенерировать: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())">
DEBUG=False
ALLOWED_HOSTS=example.com,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=island_bali
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<пароль БД>
# systemd-прод ходит в локальный кластер, docker-compose — в сервис "db"
DATABASE_URL=postgres://postgres:<пароль>@127.0.0.1:5432/island_bali

# --- Redis / Celery ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler
# Отдельная логическая БД под Channels: 0 и 1 занимает Celery
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# --- JWT ---
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=30

# --- SMS-авторизация (провайдер СМС Дисконт / iqsms.ru) ---
SMS_LOGIN=<логин SMS-шлюза>
SMS_PASSWORD=<пароль SMS-шлюза>
# Подпись обязана быть в списке утверждённых у провайдера, иначе send.json
# отвечает 'sender address invalid'. Проверить: manage.py sms_senders
SMS_SENDER=HappyIsland
SMS_API_BASE_URL=https://api.iqsms.ru/messages/v2/
SMS_ENABLED=True
SMS_CODE_TTL=300
SMS_RESEND_INTERVAL=60
# Порог баланса в рублях и чат, куда слать предупреждение (id из @getmyid_bot).
# Пусто — предупреждение остаётся только в логе.
SMS_BALANCE_MIN=500
SMS_BALANCE_ALERT_CHAT_ID=
# Сколько часов держать сообщение в опросе статуса доставки.
SMS_STATUS_MAX_AGE_HOURS=24
# Тестовый вход для ревью в сторах: SMS не шлётся, код фиксированный
SMS_TEST_LOGIN_ENABLED=False
SMS_TEST_PHONE=
SMS_TEST_CODE=

# --- Push (FCM) ---
# Service account из Firebase Console -> Project settings -> Service accounts.
# Файл на хосте, вне git. Пусто = пуши выключены (в лог пишется предупреждение).
FIREBASE_CREDENTIALS_PATH=/root/bali/secrets/firebase-service-account.json

# --- Почта ---
EMAIL_HOST_USER=<почта>
EMAIL_HOST_PASSWORD=<пароль приложения>

# --- Внешние сервисы ---
TELEGRAM_BOT_TOKEN=<токен от @BotFather>
URL_SUB_TOTAL=<url SubTotal>
RUSSIAN_STANDARD_BASE_URL=<url эквайринга>
PUSH_TOKEN=
